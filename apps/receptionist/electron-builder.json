{
  "$schema": "https://json.schemastore.org/electron-builder.json",
  "appId": "com.hotelos.receptionist",
  "productName": "HotelOS Receptionist",
  "electronVersion": "45.0.0",
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json",
    "!**/node_modules/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "mac": {
    "category": "public.app-category.business",
    "target": ["dmg", "zip"]
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Office"
  }
}

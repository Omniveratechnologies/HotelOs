{
  "name": "receptionist",
  "type": "module",
  "version": "1.0.0",
  "description": "HotelOS Receptionist Dashboard",
  "author": "Omnivera",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "vite --port 5175",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "dev:electron": "electron-vite dev",
    "build:electron": "electron-vite build && electron-builder",
    "build:electron:portable": "electron-vite build && electron-builder --win portable",
    "build:electron:nsis": "electron-vite build && electron-builder --win nsis",
    "build:electron:win": "electron-vite build && electron-builder --win",
    "build:electron:mac": "electron-vite build && electron-builder --mac",
    "build:electron:linux": "electron-vite build && electron-builder --linux",
    "pack:electron": "electron-vite build && electron-builder --dir",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@hotelos/api": "workspace:*",
    "@hotelos/platform": "workspace:*",
    "@hotelos/query": "workspace:*",
    "@hotelos/socket": "workspace:*",
    "@hotelos/stores": "workspace:*",
    "@hotelos/styles": "workspace:*",
    "@hotelos/ui": "workspace:*",
    "@hotelos/utils": "workspace:*",
    "@tanstack/react-query": "^5.101.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "recharts": "^3.10.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@hotelos/oxlint-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}

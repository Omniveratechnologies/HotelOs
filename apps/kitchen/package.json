{
  "name": "kitchen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "HotelOS Kitchen Dashboard & Display System",
  "author": "Omnivera",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "vite --port 5176",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "dev:electron": "electron-vite dev",
    "build:electron": "electron-vite build && electron-builder",
    "build:electron:portable": "electron-vite build && electron-builder --win portable",
    "build:electron:nsis": "electron-vite build && electron-builder --win nsis",
    "build:electron:win": "electron-vite build && electron-builder --win",
    "build:electron:mac": "electron-vite build && electron-builder --mac",
    "build:electron:linux": "electron-vite build && electron-builder --linux",
    "pack:electron": "electron-vite build && electron-builder --dir",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^5.9.1",
    "@hotelos/api": "workspace:*",
    "@hotelos/platform": "workspace:*",
    "@mediapipe/tasks-vision": "^1.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.19.0",
    "dayjs": "^1.11.21",
    "framer-motion": "^12.43.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.58.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.90.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.3",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@hotelos/oxlint-config": "workspace:*",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "vite": "^8.2.0"
  }
}

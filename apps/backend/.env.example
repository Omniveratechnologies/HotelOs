PORT=5000

NODE_ENV=development

# Minimum Pino log level (trace|debug|info|warn|error|fatal). Defaults to info.
LOG_LEVEL=info

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/hospitalos

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Cloudflare R2 (S3-compatible) - fill in real values to use document uploads
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_URL_TTL_SECONDS=900

# Razorpay (required for guest online food order payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Aiosell Channel Manager: credentials (pmsSlug, username, password) are stored
# in the ChannelManagerConfig document (password select:false) and managed by
# SUPER_ADMIN via the channel manager config API. The values below OPTIONALLY
# auto-provision that singleton config on first hotel creation (only taken if
# AIOSELL_PMS_SLUG is set and no config exists yet).
AIOSELL_PMS_SLUG=sample-pms
AIOSELL_PARTNER_USERNAME=aiosell
AIOSELL_PARTNER_PASSWORD=AIOsell@123
AIOSELL_BASE_URL=https://live.aiosell.com/api/v2/cm
AIOSELL_HOTEL_CODE=sandbox-pms
AIOSELL_ENABLED=true

CLIENT_URL=http://localhost:5173
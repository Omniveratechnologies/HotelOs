PORT=5001
HOST=0.0.0.0

NODE_ENV=development

# Minimum Pino log level (trace|debug|info|warn|error|fatal). Defaults to info.
LOG_LEVEL=info

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/hospitalos

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Redis connection for BullMQ queue & background worker
REDIS_URL=redis://localhost:6379

# Frontend App URLs
SUPER_ADMIN_FRONTEND_URL=http://localhost:5173
SUB_ADMIN_FRONTEND_URL=http://localhost:5174
RECEPTIONIST_FRONTEND_URL=http://localhost:5175
KITCHEN_FRONTEND_URL=http://localhost:5176
GUEST_FRONTEND_URL=http://localhost:5177
SELF_CHECKIN_FRONTEND_URL=http://localhost:5178
TABLE_ORDER_FRONTEND_URL=http://localhost:5179

# Cloudflare R2 (S3-compatible) - fill in real values to use document uploads
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_URL_TTL_SECONDS=900

# Razorpay (required for guest online food order payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email / SMTP
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_password

# Super Admin Password Seed (dev)
SUPER_ADMIN_PASSWORD=supersecretpassword

# Aiosell Channel Manager (Optional)
AIOSELL_PMS_SLUG=sample-pms
AIOSELL_PARTNER_USERNAME=aiosell
AIOSELL_PARTNER_PASSWORD=AIOsell@123
AIOSELL_BASE_URL=https://live.aiosell.com/api/v2/cm
AIOSELL_HOTEL_CODE=sandbox-pms
AIOSELL_ENABLED=true

# Groq Narration (Optional)
GROQ_API_KEY=
MODEL=qwen/qwen3.8-27b

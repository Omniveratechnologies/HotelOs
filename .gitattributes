# Auto detect text files and perform LF normalization
* text=auto

# JavaScript/TypeScript/JSX/TSX files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# JSON/Config files
*.json text eol=lf
*.jsonc text eol=lf

# Markdown/Documentation
*.md text eol=lf

# CSS/Style files
*.css text eol=lf
*.scss text eol=lf

# Config files
*.config.* text eol=lf
*.rc.* text eol=lf

# Environment files
*.env* text eol=lf

# Shell scripts
*.sh text eol=lf

# Git files
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files - don't touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
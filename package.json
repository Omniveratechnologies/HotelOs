{
  "name": "hotel-os",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-kiosk-ip.mjs && turbo dev",
    "dev:kiosk": "node scripts/dev-kiosk.mjs",
    "dev:kitchen:desktop": "pnpm --filter kitchen dev:electron",
    "dev:receptionist:desktop": "pnpm --filter receptionist dev:electron",
    "sync:ip": "node scripts/sync-kiosk-ip.mjs",
    "build": "turbo build",
    "preview": "turbo preview",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "prepare": "husky",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxlint": "^1.94.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24.15.0"
  }
}

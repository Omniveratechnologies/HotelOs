{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "PORT",
    "HOST",
    "NODE_ENV",
    "LOG_LEVEL",
    "MONGODB_URI",
    "JWT_SECRET",
    "JWT_EXPIRES_IN",
    "CLIENT_URL",
    "FRONTEND_URL",
    "EMAIL_HOST",
    "EMAIL_PORT",
    "EMAIL_SECURE",
    "EMAIL_USER",
    "EMAIL_PASSWORD",
    "SUPER_ADMIN_PASSWORD",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET_NAME",
    "R2_URL_TTL_SECONDS",
    "VITE_API_URL",
    "EXPO_PUBLIC_API_URL",
    "EXPO_PUBLIC_SOCKET_URL",
    "KIOSK_DEMO_PORTAL_URL",
    "KIOSK_GUEST_CHECKIN_URL",
    "KIOSK_TABLE_ORDER_URL",
    "KIOSK_RECEPTIONIST_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    }
  }
}
